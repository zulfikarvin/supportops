{
  "name": "supportops",
  "private": true,
  "engines": { "node": ">=22.17.0" },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:full": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
