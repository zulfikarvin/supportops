NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
SUPPORTOPS_AUTH_MODE=demo
# Hosted role picker on Vercel: set SUPPORTOPS_AUTH_MODE=portfolio instead.
# portfolio uses Supabase persistence and automatically provisions five synthetic personas.
# supabase keeps administrator-provisioned email/password login.
# Required for hosted portfolio access and Supabase attachments; never expose as NEXT_PUBLIC_:
# SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
DIAGNOSTICS_URL=http://127.0.0.1:8001
# Generate a random token of at least 32 characters; use the same token in Python.
DIAGNOSTICS_API_TOKEN=replace-with-a-long-local-service-token
